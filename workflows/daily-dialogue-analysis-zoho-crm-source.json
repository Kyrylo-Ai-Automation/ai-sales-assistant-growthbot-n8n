      "id": "37bcd85f-b13a-4167-bf5d-fe2b8800558c",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const r = item.json || {};\n  let payload = {};\n  const rawDescription = r.Description ?? r.description ?? '';\n  if (typeof rawDescription === 'string' && rawDescription.trim()) {\n    try { payload = JSON.parse(rawDescription); } catch (_) {}\n  } else if (rawDescription && typeof rawDescription === 'object') {\n    payload = rawDescription;\n  }\n  const pick = (...values) => values.find(v => v !== undefined && v !== null && String(v).trim() !== '');\n  const session = pick(r.Skype_ID, r.SkypeId, r.skype_id, payload.session_id, payload.sessionId, '');\n  const scoreRaw = pick(payload.score, r.Score, r.score, '');\n  const scoreNum = scoreRaw === '' ? '' : Number(scoreRaw);\n  const score = Number.isFinite(scoreNum) && scoreNum >= 0 && scoreNum <= 10 ? scoreNum : '';\n  const statusRaw = pick(payload.status, r.Status, r.status, '');\n  const status = score !== '' ? (score <= 3 ? 'Disqualified' : score <= 7 ? 'In Progress' : 'Qualified') : 'Undetermined';\n  return { json: {\n    ...r,\n    lead_id: session ? 'GL-' + session : pick(payload.lead_id, r.Lead_ID, r.lead_id, r.id, ''),\n    session_id: session,\n    name: pick(payload.name, r.Full_Name, [r.First_Name, r.Last_Name].filter(Boolean).join(' '), r.Last_Name, ''),\n    phone: pick(payload.phone, r.Phone, r.Mobile, ''),\n    need: pick(payload.need, r.Need, r.need, 'Не визначено'),\n    budget: pick(payload.budget, r.Budget, r.budget, 'Не визначений'),\n    authority: pick(payload.authority, r.Authority, r.authority, 'Не визначено'),\n    timeline: pick(payload.timeline, r.Timeline, r.timeline, 'Не визначено'),\n    score,\n    status,\n    analysis: pick(payload.analysis, r.Analysis, r.analysis, ''),\n    messages: pick(r.messages, r.Messages, ''),\n  }};\n});"
      },
