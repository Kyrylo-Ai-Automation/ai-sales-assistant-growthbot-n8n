            "lead_id": "={{ $('Loop Over Items').item.json.lead_id }}",
            "session_id": "={{ $('Loop Over Items').item.json.session_id }}",
            "name": "={{ $('Loop Over Items').item.json.name }}",
            "phone": "={{ (() => { const p = $('Loop Over Items').item.json.phone; if (p === undefined || p === null || String(p).trim() === '' || ['0Не надано','Не надано','Не визначено','Unknown'].includes(String(p).trim())) return ''; return String(p).trim(); })() }}",
            "need": "={{ $('Loop Over Items').item.json.need }}",
            "budget": "={{ $('Loop Over Items').item.json.budget }}",
            "authority": "={{ $('Loop Over Items').item.json.authority }}",
            "timeline": "={{ $('Loop Over Items').item.json.timeline }}",
            "score": "={{ $('Loop Over Items').item.json.score }}",
            "status": "={{ (() => { const s = $('Loop Over Items').item.json.score; if (s === '' || s === null || s === undefined) return 'Undetermined'; const n = Number(s); if (!Number.isFinite(n) || n < 0 || n > 10) return 'Undetermined'; return n <= 3 ? 'Disqualified' : n <= 7 ? 'In Progress' : 'Qualified'; })() }}",
            "analysis": "={{ ($('Chat Memory Manager').item.json.messages || []).length ? $json.output : ($('Loop Over Items').item.json.analysis || '') }}"
